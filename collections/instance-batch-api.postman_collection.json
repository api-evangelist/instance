          "id": "953ffb99-41f8-430f-82d0-602116a7c392",
          "name": "V1 Batch Start",
          "request": {
            "name": "V1 Batch Start",
            "description": {
              "content": "Submit a batch of videos for ASYNCHRONOUS verification (finetune/h1\nonly — Opus is a per-clip call via /v1/verify).\n\n`mode=\"single\"`: one attempt per video. `mode=\"multi\"`: each video may\nhold several sequential attempts of the same task, auto-segmented into\nper-attempt rollouts. Large files can be sent via the chunked-upload flow\n(/api/upload/begin + /chunk) and passed as `tokens` (a JSON array of\nupload ids) instead of `files`.\n\nReturns a `batch_id`; poll GET /v1/batch/{id} until status is `done`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
