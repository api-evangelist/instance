        {
          "id": "c8f51462-a42d-4011-8dd2-4e15d522e64b",
          "name": "Feed Endpoint",
          "request": {
            "name": "Feed Endpoint",
            "description": {
              "content": "Live-feed poll: entries newer than `since` (a seq from a prior poll).\nsince=0 replays the whole retained deque — that's the refresh story.\n`session` narrows to one phone's takes so several people can demo at once\n(/?live=<session> pairs a laptop with one phone; /?live=1 shows everyone).\narchived=0 (the wall) excludes archived takes; archived=1 is the archive\nview. `archived_seqs` rides along every poll so a viewer that already\nrendered a card learns it was archived elsewhere and can drop it.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "feed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "session",
                  "value": ""
                },
                {
                  "disabled": false,
                  "key": "archived",
                  "value": "0"
                }
