          "request": {
            "name": "Feed Archive",
            "description": {
              "content": "Curate the wall: flip one take's archived flag (archive or restore).\nIn-memory like the FEED itself — flags share the feed's lifetime (pod\nrestart or deque eviction clears both), which is all curation needs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "feed",
                "archive"
