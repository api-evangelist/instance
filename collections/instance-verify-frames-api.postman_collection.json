          "name": "V1 Verify Frames",
          "request": {
            "name": "V1 Verify Frames",
            "description": {
              "content": "Verify from frames the CLIENT already sampled — no video upload, no\nserver-side decode. The browser extracts N frames from the local video and\nposts them here; we run the same h1 verdict on them. This makes verdict\nlatency a tiny, constant frame upload instead of shipping (and decoding) the\nwhole video, so it no longer scales with clip length.",
              "type": "text/plain"
            },
