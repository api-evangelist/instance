          "name": "Ingest Endpoint",
          "request": {
            "name": "Ingest Endpoint",
            "description": {
              "content": "One live take from the phone: verify it and push it onto the feed.\n\nBlocks for the ~1-3s of frame sampling + h1 so the recorder sees the\nverdict in hand; the feed entry is appended BEFORE we return, so the big\nscreen never depends on the phone's connection surviving the response.\nError results are fed too — a failed take should show on screen, not\nvanish silently.",
              "type": "text/plain"
            },
