{
  "opencollection": "1.0.0",
  "info": {
    "name": "Robot rollout verifier Archive Job API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Job",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Job Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/job/:job_id",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Poll a verify job: finished items[cursor:] plus progress. The items\nalready consumed are never re-sent — result payloads embed data-URI\nframes, so replaying them every poll would swamp the connection."
        }
      ]
    }
  ],
  "bundled": true
}